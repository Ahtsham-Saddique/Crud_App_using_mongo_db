<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Your custom CSS -->
    <link rel="stylesheet" href="/stylesheets/style.css">

    <!-- Tailwind CSS -->
   <script src="https://cdn.tailwindcss.com"></script>
    <title>view_page</title>
</head>

<body> 
    

    <!-- Full screen dark background with padding -->
    <div class="w-full min-h-screen bg-zinc-900  p-10">
        <div class="back p-2 mb-5">
        <a href="/" class=" text-blue-500">Back_to_home</a>
    </div>
       <h1 class="text-3xl text-white tracking-tighter mb-3">All_users</h1>
         <div class="user flex gap-3 flex-wrap ">
                <% if(users.length > 0 ){ %>
                        <% users.forEach((user)=>{%>        
        
             <div class="user max-w-72 p-4 bg-zinc-800 rounded-lg">
                
                <div class="w-full h-52 rounded-lg overflow-hidden bg-red-500">
                        <img class="w-full h-full object-cover object-top "src="<%= user.image %>" alt="No image found">
                </div>
                <h1 class="text-white text-2xl"><%= user.name%></h1>
                <h3 class="text-zinc-500"><%= user.email %></h3>
                <div class="flex gap-5 mt-2">
                      
                <a href="/editpage/<%=user._id%>"   class="bg-green-500 py-1 px-2 text-white rounded-lg" >edit_user</a>
                <a href="/delete/<%= user._id %>"   class="bg-red-500 py-1 px-2 text-white rounded-lg" >delete_user</a>

                </div>

             </div>
          

          <% })%>

                        <% } else { %>
                     <!-- <div class="nouser text-white flex flex-col items-center mt-10"> -->
                        <div class="nouser w-full text-white flex flex-col items-center mt-10">

                        <h1>
                            No user exists
                           </h1>

                      <a href="/" class="text-blue-500 mt-5 ">
                           Go to_Create_user
                          </a>

</div>
                       <% } %>
       

            </div>
             
              
          
        
   
    </div>

</body>
</html>