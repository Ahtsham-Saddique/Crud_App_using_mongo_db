<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.tailwindcss.com"></script>

    <title>Create User</title>
</head>

<body class="bg-zinc-950">

<div class="min-h-screen flex items-center justify-center px-6 py-12">

    <div class="w-full max-w-4xl">

        <!-- Header -->

        <div class="flex items-center justify-between mb-8">

            <div>

                <h1 class="text-4xl font-bold text-white">
                    Create User
                </h1>

                <p class="text-zinc-400 mt-2">
                    Add a new user to your application.
                </p>

            </div>

        

        </div>

        <!-- Card -->

        <div class="bg-zinc-900 border border-zinc-800 rounded-3xl shadow-xl p-10">

            <form action="/create" method="POST" class="space-y-7">

                <!-- Name -->

                <div>

                    <label
                        class="block mb-2 text-sm font-medium text-zinc-300">

                        Full Name

                    </label>

                    <input
                        type="text"
                        name="name"
                        placeholder="Enter full name"

                        class="w-full rounded-xl bg-zinc-950 border border-zinc-700 px-4 py-3 text-white placeholder:text-zinc-500 outline-none focus:border-indigo-500 transition">

                </div>

                <!-- Email -->

                <div>

                    <label
                        class="block mb-2 text-sm font-medium text-zinc-300">

                        Email Address

                    </label>

                    <input
                        type="email"
                        name="email"
                        placeholder="example@email.com"

                        class="w-full rounded-xl bg-zinc-950 border border-zinc-700 px-4 py-3 text-white placeholder:text-zinc-500 outline-none focus:border-indigo-500 transition">

                </div>

                <!-- Image -->

                <div>

                    <label
                        class="block mb-2 text-sm font-medium text-zinc-300">

                        Image URL

                    </label>

                    <input
                        type="text"
                        name="image"
                        placeholder="https://..."

                        class="w-full rounded-xl bg-zinc-950 border border-zinc-700 px-4 py-3 text-white placeholder:text-zinc-500 outline-none focus:border-indigo-500 transition">

                </div>

                <!-- Button -->

                <div class="pt-2">

                    <button
                        type="submit"

                        class="w-full rounded-xl bg-indigo-600 hover:bg-indigo-500 py-3 text-white font-semibold transition">

                        Create User

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

</body>
</html>